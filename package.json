{
  "name": "n-mgram",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e:history": "bun scripts/e2e-history-progress.mjs",
    "test:watch": "vitest",
    "sync:android-icons": "bun scripts/sync-android-icons.mjs",
    "check": "bun run lint && bun run format && bun run type-check && bun run test && bun run build && bun run test:e2e:history",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-http": "2.7.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.0",
    "page-flip-2": "0.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
